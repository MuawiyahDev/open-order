# API secrets - copy this file to .env and fill in real values
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000

# Comma-separated list of API keys accepted for machine-to-machine auth
API_KEY=

# Directory where uploaded image files are stored (relative paths resolve from
# the API working directory). The directory is created automatically at startup
# and must be writable by the API process.
IMAGE_STORAGE_DIR=uploads/images

# Maximum accepted image upload size in bytes (default: 5242880 = 5 MB)
IMAGE_MAX_FILE_SIZE=5242880